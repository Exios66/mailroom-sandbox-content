{
 "$id": "https://github.com/Exios66/mailroom-sandbox-content/schemas/scenario.v2.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "description": "Scenario file format v2 (addendum v2 \u00a74.8). One YAML file per scenario under scenarios/<Series>/.",
 "properties": {
  "expect": {
   "properties": {
    "boss_actions": {
     "items": {
      "enum": [
       "ack_signal",
       "dismiss_signal",
       "link_documents",
       "annotate_document",
       "raise_priority",
       "request_human_review",
       "task_correspondent",
       "approve_outbound",
       "hold_attachments",
       "quarantine_attachments",
       "release_attachments",
       "recommend_callback"
      ]
     },
     "type": "array"
    },
    "docs": {
     "description": "Per-attachment doc expectations keyed by filename",
     "type": "object"
    },
    "intent": {
     "enum": [
      "status_request",
      "missing_document_followup",
      "document_submission",
      "correction_or_amendment",
      "duplicate_submission",
      "complaint",
      "urgent_deadline",
      "general_question",
      "unrelated",
      "auto_reply",
      "bounce",
      "spam_or_phishing",
      "possible_prompt_injection",
      "legal_notice",
      "privacy_request",
      "payment_or_identity_change",
      "conflicting_instructions",
      "retraction_or_withdrawal",
      "disclosure_request"
     ]
    },
    "invariants": {
     "items": {
      "enum": [
       "audit_chain_ok",
       "no_stuck_docs",
       "fast_path_two_calls",
       "comms_offpath"
      ]
     },
     "type": "array"
    },
    "outbox": {
     "items": {
      "properties": {
       "intent": {
        "type": "string"
       },
       "state": {
        "enum": [
         "draft",
         "approved",
         "sent"
        ]
       },
       "to_sender": {
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "type": "array"
    },
    "overblocking": {
     "description": "For benign messages / benign companions: expected hard actions (usually 0)",
     "properties": {
      "benign_hard_actions": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "type": "object"
    },
    "quarantine": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "relations": {
     "items": {
      "properties": {
       "a": {
        "type": "string"
       },
       "b": {
        "type": "string"
       },
       "kind": {
        "enum": [
         "references",
         "supersedes",
         "duplicates",
         "amends",
         "answers",
         "contradicts",
         "withdraws",
         "completes",
         "unknown"
        ]
       },
       "min_conf": {
        "maximum": 1.0,
        "minimum": 0.0,
        "type": "number"
       }
      },
      "required": [
       "a",
       "b",
       "kind"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "signals": {
     "items": {
      "properties": {
       "attack_class": {
        "enum": [
         "impersonation",
         "payment_fraud",
         "credential_phish",
         "injection",
         "exfiltration",
         "malicious_attachment",
         "other"
        ]
       },
       "kind": {
        "enum": [
         "new_info",
         "doc_relation",
         "status_request",
         "missing_doc",
         "correction",
         "complaint",
         "urgent",
         "possible_attack",
         "fyi",
         "legal_notice",
         "privacy_request",
         "payment_change"
        ]
       },
       "priority": {
        "enum": [
         "low",
         "normal",
         "high",
         "critical"
        ]
       },
       "within": {
        "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "priority"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "soft_hold": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "trust": {
     "properties": {
      "sender_level": {
       "enum": [
        "verified",
        "unverified",
        "suspicious",
        "hostile"
       ]
      }
     },
     "required": [
      "sender_level"
     ],
     "type": "object"
    }
   },
   "required": [
    "intent"
   ],
   "type": "object"
  },
  "gen": {
   "enum": [
    "scripted",
    "frozen",
    "live",
    "loop"
   ]
  },
  "name": {
   "description": "Series letter + number + slug, e.g. E1_lookalike_wire_change",
   "pattern": "^[A-T][0-9]+_[a-z0-9_]+$",
   "type": "string"
  },
  "owner": {
   "type": "string"
  },
  "profile": {
   "enum": [
    "smoke",
    "demo",
    "prod_like",
    "chaos",
    "coverage"
   ]
  },
  "seed": {
   "minimum": 0,
   "type": "integer"
  },
  "status": {
   "default": "draft",
   "enum": [
    "draft",
    "review",
    "frozen",
    "deprecated"
   ]
  },
  "tags": {
   "items": {
    "type": "string"
   },
   "type": "array"
  },
  "timeline": {
   "items": {
    "properties": {
     "at": {
      "description": "Virtual-clock offset mm:ss",
      "pattern": "^[0-9]{2}:[0-9]{2}(:[0-9]{2})?$",
      "type": "string"
     },
     "attach": {
      "items": {
       "description": "Attachment drawn by pinned file or by {class, stratum} from the dataset train split",
       "properties": {
        "class": {
         "type": "string"
        },
        "file": {
         "description": "Pinned fixture filename",
         "type": "string"
        },
        "in_taxonomy": {
         "type": "boolean"
        },
        "stratum": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "client": {
      "properties": {
       "auth": {
        "properties": {
         "dkim": {
          "enum": [
           "pass",
           "fail",
           "none",
           "softfail",
           "temperror",
           "permerror"
          ]
         },
         "dmarc": {
          "enum": [
           "pass",
           "fail",
           "none"
          ]
         },
         "spf": {
          "enum": [
           "pass",
           "fail",
           "none",
           "softfail",
           "temperror",
           "permerror"
          ]
         }
        },
        "type": "object"
       },
       "channel": {
        "default": "email",
        "enum": [
         "email",
         "ticket",
         "chat",
         "portal"
        ]
       },
       "claimed_from": {
        "description": "Synthetic sender identity the message should appear to have",
        "type": "string"
       },
       "gen_spec": {
        "pattern": "^gen_[a-zA-Z0-9_]+$",
        "type": "string"
       },
       "persona": {
        "pattern": "^p_[a-z0-9_]+$",
        "type": "string"
       },
       "template": {
        "type": "string"
       }
      },
      "required": [
       "persona"
      ],
      "type": "object"
     },
     "fault": {
      "description": "FaultInjector directive, e.g. crash_mid_triage, duplicate_delivery",
      "type": "string"
     },
     "ingress": {
      "description": "Document ingress event (pipeline side)",
      "properties": {
       "doc": {
        "type": "string"
       }
      },
      "required": [
       "doc"
      ],
      "type": "object"
     }
    },
    "required": [
     "at"
    ],
    "type": "object"
   },
   "minItems": 1,
   "type": "array"
  },
  "title": {
   "type": "string"
  },
  "transports": {
   "description": "Legs the scenario is valid on. Identity-dependent scenarios (E1, E2, E13, ...) are not valid on the gmail leg.",
   "items": {
    "enum": [
     "sim",
     "agentmail",
     "gmail"
    ]
   },
   "minItems": 1,
   "type": "array"
  }
 },
 "required": [
  "name",
  "seed",
  "profile",
  "gen",
  "transports",
  "timeline",
  "expect"
 ],
 "title": "mailroom.scenario/v2",
 "type": "object"
}